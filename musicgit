def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="musicgit",
        description="Keep a local music folder in sync with YouTube Music playlists.",
    )
    parser.add_argument("-C", metavar="DIR", help="run as if musicgit started in DIR")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("init", help="create an empty library repo")
    p.add_argument("dir", nargs="?", help=f"where (default: {DEFAULT_LIBRARY})")

    p = sub.add_parser("remote", help="manage playlists (remotes)")
    p.add_argument("action", choices=["add", "list", "remove"])
    p.add_argument("name", nargs="?")
    p.add_argument("url", nargs="?")

    p = sub.add_parser("status", help="show what pull would change (uses last snapshot)")
    p.add_argument("remote", nargs="?")

    p = sub.add_parser("fetch", help="refresh playlist snapshots without downloading")
    p.add_argument("remote", nargs="?")

    for name, help_text in (("pull", "download new tracks and report failures"),
                            ("sync", "alias for pull")):
        p = sub.add_parser(name, help=help_text)
        p.add_argument("remote", nargs="?")
        p.add_argument("-j", "--jobs", type=int, default=1,
                       help="download N tracks at once (default 1)")
        p.add_argument("--prune", action="store_true",
                       help="move tracks deleted upstream into .musicgit/removed/")
        p.add_argument("--dry-run", action="store_true", help="show what would happen")

    p = sub.add_parser("retry", help="re-download only the songs that failed")
    p.add_argument("remote", nargs="?")
    p.add_argument("-j", "--jobs", type=int, default=1,
                   help="retry N tracks at once (default 1)")
    p.add_argument("--search", action="store_true",
                   help="if a video is gone, download the best alternate upload instead")
    p.add_argument("--only", metavar="IDS",
                   help="comma separated video ids to retry (default: all failures)")

    p = sub.add_parser("failed", help="list songs that failed to download")
    p.add_argument("remote", nargs="?")
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("retag", help="clean artist tags on files already on disk")
    p.add_argument("remote", nargs="?")
    p.add_argument("--dry-run", action="store_true")

    p = sub.add_parser("log", help="show sync history")
    p.add_argument("remote", nargs="?")
    p.add_argument("-n", "--limit", type=int, default=20)

    p = sub.add_parser("config", help="show or change settings")
    p.add_argument("--cookies-from-browser", metavar="BROWSER")
    p.add_argument("--cookies-file", metavar="FILE")
    p.add_argument("--audio-format", metavar="FMT")

    return parser


COMMANDS = {
    "init": cmd_init, "remote": cmd_remote, "status": cmd_status,
    "fetch": cmd_fetch, "pull": cmd_pull, "sync": cmd_pull,
    "retry": cmd_retry, "failed": cmd_failed, "log": cmd_log, "config": cmd_config,
    "retag": cmd_retag,
}


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return COMMANDS[args.command](args)
    except KeyboardInterrupt:
        print("\nmusicgit: interrupted - finished songs are kept, "
              "failures so far are recorded", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
